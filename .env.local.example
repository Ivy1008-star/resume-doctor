# ============================================================
# Resume Doctor - Environment Variables
# Copy this file to .env.local and fill in your real keys.
# ============================================================

# ---- DeepSeek (AI diagnosis / rewrite / interview prediction) ----
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE=https://api.deepseek.com
# Model id. PRD asks for "deepseek-v4-flash". If DeepSeek returns a
# "model not found" error, switch this to deepseek-chat.
DEEPSEEK_MODEL=deepseek-v4-flash

# ---- Google Sign-In (Google Identity Services) ----
# Create an OAuth 2.0 Client ID (Web) at https://console.cloud.google.com
# Authorized JavaScript origin: http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# Optional: outbound proxy used ONLY for reaching Google during local dev, for
# networks that can't connect to googleapis.com directly (e.g. http://127.0.0.1:7890).
# Leave blank in production / on Cloudflare.
GOOGLE_PROXY=

# ---- Session signing secret (any long random string) ----
SESSION_SECRET=change_me_to_a_long_random_string

# ---- PayPal (Smart Buttons) ----
# Get credentials from https://developer.paypal.com (Sandbox for testing)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_secret
# sandbox | live
PAYPAL_ENV=sandbox

# ---- Pricing (USD) ----
PRICE_REWRITE=5
PRICE_PREMIUM=10
# Monthly Pro subscription price. Also set PAYPAL_PLAN_ID after you create the
# plan (run: node scripts/create-plan.mjs once PayPal creds are filled in).
PRICE_MONTHLY=12
PAYPAL_PLAN_ID=

# ---- Abuse protection ----
# Free diagnoses allowed per user/IP per day.
DAILY_ANALYSIS_LIMIT=3
# Daily diagnoses allowed for Pro subscribers.
DAILY_ANALYSIS_LIMIT_PRO=30
